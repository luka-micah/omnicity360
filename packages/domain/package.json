{
  "name": "@hotel-marketplace/domain",
  "version": "0.0.0",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./money": {
      "types": "./dist/money.d.ts",
      "import": "./dist/money.js",
      "require": "./dist/money.js"
    },
    "./dates": {
      "types": "./dist/dates.d.ts",
      "import": "./dist/dates.js",
      "require": "./dist/dates.js"
    },
    "./state-machines": {
      "types": "./dist/state-machines.d.ts",
      "import": "./dist/state-machines.js",
      "require": "./dist/state-machines.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "format": "prettier --write \"**/*.{ts,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,json,md,yml,yaml}\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {},
  "devDependencies": {
    "typescript": "^5.4.3",
    "vitest": "^1.4.0"
  }
}
