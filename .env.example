# API environment template.
# Copy this file to apps/api/.env and fill in real values:
#   Copy-Item .env.example apps/api/.env
# Never put real credentials in this template. apps/api/.env is git-ignored.

# Application
NODE_ENV=development
PORT=3001
API_BASE_URL=http://localhost:3001
WEB_BASE_URL=http://localhost:3000
VITE_API_BASE_URL=http://localhost:3001/api/v1
MOBILE_SCHEME=hotelmarketplace

# Database
# Local PostgreSQL example:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hotel_marketplace?schema=public
# Neon example (use the direct host, without -pooler, for migrations):
# DATABASE_URL=postgresql://user:password@ep-xxxx.c-6.us-east-2.aws.neon.tech/neondb?sslmode=require

# Test database (optional; must end in "_test"). Tests refuse any other database.
# TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hotel_marketplace_test?schema=public

# Redis (not required through Phase 2; in-memory rate limits are single-process only)
# REDIS_URL=redis://localhost:6379

# Session (minimum 32 characters; generate a random value)
SESSION_SECRET=replace-with-at-least-32-random-characters
# Access/refresh token lifetimes (seconds/days). Remember-me uses the longer refresh TTL.
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
REMEMBER_ME_TTL_DAYS=90
PASSWORD_RESET_TTL_MINUTES=60
EMAIL_VERIFICATION_TTL_HOURS=24

# Payment Provider (configure one)
# PAYMENT_PROVIDER=flutterwave
# PAYMENT_SECRET_KEY=sk_test_xxx
# PAYMENT_PUBLIC_KEY=pk_test_xxx
# PAYMENT_WEBHOOK_SECRET=whsec_xxx

# Email Provider
# EMAIL_PROVIDER=sendgrid
# EMAIL_API_KEY=sg.xxx
# EMAIL_FROM=noreply@hotelmarketplace.ng

# Storage Provider
# STORAGE_PROVIDER=cloudinary
# CLOUDINARY_CLOUD_NAME=your-cloud-name
# CLOUDINARY_API_KEY=your-api-key
# CLOUDINARY_API_SECRET=your-api-secret

# Logging
LOG_LEVEL=info
